{
  "name": "mmail-backend",
  "version": "0.1.0",
  "description": "mMail - Plataforma de Email Marketing - Mais Chat Tecnologia",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec \"ts-node src/server.ts\"",
    "seed:admin": "ts-node src/config/seedAdmin.ts",
    "seed:admin:prod": "node dist/config/seedAdmin.js",
    "rotate:encryption": "ts-node src/scripts/rotateEncryption.ts",
    "rotate:encryption:prod": "node dist/scripts/rotateEncryption.js",
    "migrate:multi-tenant": "ts-node src/scripts/migrateToMultiTenant.ts",
    "migrate:multi-tenant:prod": "node dist/scripts/migrateToMultiTenant.js",
    "lint": "biome check src",
    "lint:fix": "biome check src --write",
    "format": "biome format src --write",
    "typecheck": "tsc --noEmit",
    "audit:ci": "npm audit --audit-level=high",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "prepare": "husky || true",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "handlebars": "^4.7.9",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.7.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "rate-limit-redis": "^4.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.7.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "husky": "^9.1.7",
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
