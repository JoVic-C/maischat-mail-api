{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "moduleResolution": "node",
    "typeRoots": ["./node_modules/@types"]
  },
  "ts-node": {
    // Carrega os .d.ts do projeto (augmentation do Request do Express).
    "files": true,
    // Sem checagem de tipos no boot: o `tsc` completo custa ~14s A CADA start do
    // nodemon, e era isso que atrasava a subida em desenvolvimento. Os tipos
    // continuam garantidos fora do caminho quente — `npm run typecheck`, o hook
    // de pre-commit e o CI. Não afeta build nem produção, que usam `tsc` de fato.
    "transpileOnly": true
  },
  "include": ["src/**/*.ts"],
  // Os testes ficam fora do build: sao rodados pelo vitest, que transpila por conta
  // propria, e nao devem ir para dist/ nem para a imagem de producao.
  "exclude": ["node_modules", "dist", "src/tests"]
}
