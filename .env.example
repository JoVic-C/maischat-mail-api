# ════════════════════════════════════════════
# mMAIL — MAIS CHAT TECNOLOGIA
# Plataforma de Email Marketing
# ════════════════════════════════════════════

PORT=3000
NODE_ENV=development

# Frontend (CORS / links de tracking)
FRONTEND_URL=http://localhost:4200
# URL pública da API — usada para montar pixel/redirect nos emails
PUBLIC_API_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb://localhost:27017/mailpulse

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Redis (fila de envio BullMQ)
REDIS_URL=redis://localhost:6379

# Auto-pausa a campanha se os erros (falhas + bounces) excederem este limite (estilo Listmonk)
CAMPAIGN_MAX_ERRORS=100

# ─── xMailer: SMTP PADRÃO (fallback) ───
# Usado quando o cliente NÃO cadastrou nenhum servidor SMTP próprio.
# Confirme o host SMTP correto no painel/suporte do xMailer.
XMAILER_SMTP_HOST=smtp.xmailer.com.br
XMAILER_SMTP_PORT=587
XMAILER_SMTP_USER=
XMAILER_SMTP_PASS=
XMAILER_FROM_NAME=mMail
XMAILER_FROM_EMAIL=

# Teto de espera de um envio numa campanha pausada (ms). Passado esse tempo o envio
# é encerrado como falha, em vez de ficar reciclando no Redis para sempre. Padrão: 24h.
CAMPAIGN_MAX_PAUSE_WAIT_MS=86400000

# ─── Segurança ───
# Segredo do JWT (obrigatório — a API não sobe sem)
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Máximo de tentativas de LOGIN por janela (só conta as que falham)
RATE_LIMIT_AUTH_MAX=10
# Origens extras liberadas no CORS, separadas por vírgula (ex.: https://app.cliente.com)
CORS_ORIGINS=
# Chave de criptografia dos campos sensíveis (obrigatório — telefone, senha SMTP)
ENCRYPTION_KEY=
# Chave ANTERIOR, só durante uma rotação: mantém a leitura dos dados antigos
# funcionando até `npm run rotate:encryption` reescrever tudo com a chave nova.
ENCRYPTION_KEY_PREVIOUS=

# ─── Admin inicial (npm run seed:admin) ───
ADMIN_EMAIL=
# Se ficar vazio, uma senha aleatória forte é gerada e impressa uma única vez.
ADMIN_PASSWORD=
ADMIN_NAME=

# ─── Envio ───
# Destinatários materializados por vez ao disparar uma campanha
CAMPAIGN_BATCH_SIZE=1000

# Motor de envio: valores usados APENAS na primeira subida, para semear os ajustes da
# plataforma. Depois disso a fonte da verdade é o banco, editável pelo superadmin em
# /plataforma — mudar aqui não tem mais efeito.
EMAIL_WORKER_CONCURRENCY=5
EMAIL_WORKER_RATE_PER_MINUTE=600

# ─── Observabilidade ───
# Sem SENTRY_DSN o Sentry fica desligado (dev/testes rodam sem rede)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# ─── Webhook do xMailer ───
# Sem este token a rota /api/webhooks/xmailer responde 503 (fail-closed)
XMAILER_WEBHOOK_TOKEN=

# ─── Multi-tenancy (migração) ───
# Cliente padrão que recebe a base pré-existente ao rodar `npm run migrate:multi-tenant`
MIGRATION_TENANT_SLUG=principal
MIGRATION_TENANT_NAME=Cliente principal

# ─── Convites de acesso ───
# Validade do link de convite, em horas (o convidado define a própria senha nele)
INVITE_TTL_HOURS=72

# Validade do link de recuperação de senha, em minutos (curta: é credencial por email)
PASSWORD_RESET_TTL_MINUTES=60
